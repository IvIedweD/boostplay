# Рабочая конфигурация сайта. VITE_* попадает в клиентский bundle,
# поэтому здесь допустим только публичный publishable key, но не service_role.
VITE_AUTH_MODE=supabase
VITE_SUPABASE_URL=https://cdoplnpqrvlhtramplwl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=ВСТАВЬТЕ_PUBLIC_PUBLISHABLE_KEY

# Альтернативный режим для собственного серверного API с cookie-сессией:
# VITE_AUTH_MODE=server
# VITE_API_BASE_URL=https://api.example.com

# Автономный режим разрешён только для намеренной локальной разработки:
# VITE_AUTH_MODE=local

# Секреты админ-панели задаются только в Supabase Edge Function Secrets,
# никогда не добавляйте их в локальный VITE_* env:
# ADMIN_PANEL_PASSWORD_SHA256=<sha256 секретного пароля>
# ADMIN_ALLOWED_ORIGINS=https://ваш-домен.example
